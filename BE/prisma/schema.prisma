generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CodeSequence {
  scope String @id @db.VarChar(191)
  value BigInt @default(0)
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MachineStatus {
  ACTIVE
  MAINTENANCE
  REPAIRING
  INACTIVE
}

enum MachineInventoryStatus {
  IN_STOCK
  ACCESSORY_SPLIT
  INSTALLED
  RESERVED
  RETURNED
  SOLD
}

enum DemoLoanStatus {
  PLANNED
  HANDED_OVER
  OVERDUE
  RETURNED
  CANCELLED
}

enum DemoMachineCategory {
  DEMO_UNIT
  DEMO_STOCK
  DEMO_USED
}

enum DemoLoanMachineUse {
  DEMO_UNIT
  NEW_STOCK
  DEMO_USED
  UNKNOWN
}

enum DemoPreparationStatus {
  NOT_REQUIRED
  REQUIRED
  COMPLETED
}

enum DeviceServiceTicketStatus {
  RECEIVED
  RETURNED
  CANCELLED
}

enum OperationalDataStatus {
  PENDING_REVIEW
  VERIFIED
  NEEDS_UPDATE
}

enum OperationalCreatedSource {
  ADMIN
  ENGINEER
  IMPORT
  SYSTEM
}

enum InventoryMovementType {
  IMPORT
  SPLIT_ACCESSORY
  RESERVE
  INSTALL
  RETURN
  SELL
  ADJUST_STATUS
}

enum BusinessLineStatus {
  ACTIVE
  INACTIVE
}

enum ExpertiseGroup {
  IMAGING
  LAB_TESTING
}

model ProductIndustry {
  id String @id @default(cuid())

  code           String             @unique
  name           String
  description    String?            @db.Text
  expertiseGroup ExpertiseGroup
  status         BusinessLineStatus @default(ACTIVE)
  sortOrder      Int                @default(0)

  businessLines BusinessLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expertiseGroup])
  @@index([status])
}

enum MachineProductCategory {
  ULTRASOUND
  LAB_TESTING
  BIOCHEMISTRY
  IMMUNOLOGY
  HEMATOLOGY
  X_RAY
  ENDOSCOPY
  OTHER
}

enum RepairStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum RepairPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CustomerType {
  HOSPITAL
  CLINIC
  LAB
  DISTRIBUTOR
  UNIVERSITY
  COMPANY
  OTHER
}

enum CustomerSalesChannel {
  DIRECT
  DEALER
}

enum DataImportBatchStatus {
  PREVIEW
  IMPORTING
  IMPORTED
  FAILED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  POTENTIAL
  BLACKLISTED
}

enum MaintenanceStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum MaintenanceType {
  PERIODIC
  WARRANTY
  CONTRACT
  INTERNAL
  OTHER
}

enum InstallationStatus {
  PENDING
  INSTALLED
  CANCELLED
}

enum WorkReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  NEEDS_REVISION
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AttachmentType {
  ENGINEER_PHOTO
  MACHINE_PHOTO
  BUSINESS_LINE_IMAGE
  ERROR_PHOTO
  HANDOVER_MINUTES
  MAINTENANCE_FORM
  PART_INVOICE
  ACCEPTANCE_PDF
  OTHER
}

enum WeeklyReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  NEEDS_REVISION
}

enum DailyWorkType {
  WORK
  BUSINESS_TRIP
  LEAVE
  UNPAID_LEAVE
  REPAIR
  INSTALLATION
  MAINTENANCE
  OTHER
}

enum DailyWorkStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum KnowledgeArticleCategory {
  COMMON_FAULT
  PACKING
  REPAIR
  INSTALLATION
  MAINTENANCE
  SAFETY
  OTHER
}

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkTaskKind {
  REPAIR
  MAINTENANCE
  INSTALLATION
  DEVICE_SERVICE
}

enum UsedPartStatus {
  PLANNED
  USED
  WAITING
  RETURNED
}

enum AccessoryStockMovementType {
  IMPORT
  EXPORT
  ADJUSTMENT
}

enum TaskChecklistStatus {
  PENDING
  DONE
  SKIPPED
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  NEEDS_REVISION
}

enum ApplicationSupportChannel {
  PHONE
  ZALO
  REMOTE
  ONSITE
  EMAIL
  OTHER
}

enum ApplicationSupportIssueCategory {
  APP_ERROR
  USER_GUIDANCE
  CONFIGURATION
  HIS_RIS_PACS
  DICOM
  WORKLIST
  PRINTING
  LICENSE
  DATA_EXPORT
  TRAINING
  OTHER
}

enum ApplicationSupportWorkType {
  APP_SUPPORT
  REAGENT_SETUP
  QC_CALIBRATION
  LIS_HIS
  TRAINING
  FOLLOW_UP
  OTHER
}

enum ApplicationSupportStatus {
  RESOLVED
  WAITING_CUSTOMER
  WAITING_HOSPITAL_IT
  WAITING_VENDOR
  NEEDS_ONSITE
  FOLLOW_UP
}

model Region {
  id String @id @default(cuid())

  name String
  code String @unique

  users User[]

  customers Customer[]
  importReviewCustomers Customer[] @relation("CustomerImportReviewRegion")
  importReviewMachines  Machine[]  @relation("MachineImportReviewRegion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id String @id @default(cuid())

  code      String     @unique
  name      String     @unique
  provinces Province[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Province {
  id String @id @default(cuid())

  code      String     @unique
  name      String     @unique
  branchId  String?
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customers Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}

model Role {
  id String @id @default(cuid())

  name String @unique

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())

  email    String  @unique
  username String? @unique
  password String

  fullName String
  phone    String?

  status UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  regionId String
  region   Region @relation(fields: [regionId], references: [id])

  assignedRepairs             Repair[]                    @relation("RepairEngineer")
  repairAssignments           RepairAssignment[]
  createdRepairs              Repair[]                    @relation("RepairCreatedBy")
  reviewedRepairs             Repair[]                    @relation("RepairReviewer")
  maintenances                Maintenance[]
  maintenanceAssignments      MaintenanceAssignment[]
  reviewedMaintenances        Maintenance[]               @relation("MaintenanceReviewer")
  installedMachines           Machine[]                   @relation("MachineInstalledBy")
  machineInstallations        MachineInstallation[]       @relation("MachineInstallationEngineer")
  installationAssignments     InstallationAssignment[]
  reviewedInstallations       MachineInstallation[]       @relation("InstallationReviewer")
  demoLoans                   DemoLoan[]                  @relation("DemoLoanEngineer")
  demoLoanAssignments         DemoLoanAssignment[]
  demoLoansHandedOver         DemoLoan[]                  @relation("DemoLoanHandedOverBy")
  demoLoansReturned           DemoLoan[]                  @relation("DemoLoanReturnedBy")
  issuedWarrantyCards         WarrantyCard[]              @relation("WarrantyCardIssuedBy")
  responsibleMachines         Machine[]                   @relation("MachinePrimaryEngineer")
  machineAssignments          MachineEngineerAssignment[]
  inventoryMovements          MachineInventoryMovement[]  @relation("InventoryMovementCreatedBy")
  receivedNotifications       Notification[]              @relation("NotificationRecipient")
  sentNotifications           Notification[]              @relation("NotificationSender")
  managedBusinessLines        BusinessLine[]              @relation("BusinessLineManager")
  auditLogs                   AuditLog[]                  @relation("AuditLogActor")
  createdDataImportBatches    DataImportBatch[]           @relation("DataImportBatchCreator")
  uploadedAttachments         Attachment[]                @relation("AttachmentUploadedBy")
  engineerProfile             EngineerProfile?
  dailyWorkNotes              DailyWorkNote[]             @relation("DailyWorkNoteUser")
  reviewedDailyWorkNotes      DailyWorkNote[]             @relation("DailyWorkNoteReviewer")
  dailyReports                DailyReport[]               @relation("DailyReportUser")
  reviewedDailyReports        DailyReport[]               @relation("DailyReportReviewer")
  weeklyReports               WeeklyReport[]              @relation("WeeklyReportUser")
  reviewedWeeklyReports       WeeklyReport[]              @relation("WeeklyReportReviewer")
  primaryCustomers            Customer[]                  @relation("CustomerPrimaryEngineer")
  managedCustomers            Customer[]                  @relation("CustomerEngineers")
  createdKnowledgeArticles    KnowledgeArticle[]          @relation("KnowledgeArticleCreatedBy")
  updatedKnowledgeArticles    KnowledgeArticle[]          @relation("KnowledgeArticleUpdatedBy")
  createdWorkLogs             WorkLog[]                   @relation("WorkLogCreatedBy")
  createdUsedParts            UsedPart[]                  @relation("UsedPartCreatedBy")
  accessoryStockMovements     AccessoryStockMovement[]    @relation("AccessoryStockMovementCreatedBy")
  updatedTaskChecklistItems   TaskChecklistItem[]         @relation("TaskChecklistUpdatedBy")
  applicationSupportCases     ApplicationSupportCase[]    @relation("ApplicationSupportEngineer")
  deviceServiceTickets        DeviceServiceTicket[]
  createdDeviceServiceTickets DeviceServiceTicket[]       @relation("DeviceServiceTicketCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeArticle {
  id String @id @default(cuid())

  title     String
  summary   String? @db.Text
  content   String? @db.Text
  modelHint String?
  ownerTeam String?

  category KnowledgeArticleCategory @default(OTHER)
  status   KnowledgeArticleStatus   @default(PUBLISHED)

  tags      Json    @default("[]")
  symptoms  Json    @default("[]")
  steps     Json    @default("[]")
  checklist Json    @default("[]")
  note      String? @db.Text

  sortOrder Int @default(0)

  createdById String?
  createdBy   User?   @relation("KnowledgeArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("KnowledgeArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
  @@index([sortOrder])
}

model DailyWorkNote {
  id String @id @default(cuid())

  userId String
  user   User   @relation("DailyWorkNoteUser", fields: [userId], references: [id], onDelete: Cascade)

  title     String
  note      String?
  workDate  DateTime
  startTime String?
  endTime   String?
  color     String?
  type      DailyWorkType   @default(WORK)
  status    DailyWorkStatus @default(APPROVED)

  reviewedAt   DateTime?
  reviewerId   String?
  reviewer     User?     @relation("DailyWorkNoteReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, workDate])
  @@index([type])
  @@index([status])
  @@index([reviewerId])
}

model WeeklyReport {
  id String @id @default(cuid())

  userId String
  user   User   @relation("WeeklyReportUser", fields: [userId], references: [id], onDelete: Cascade)

  weekStart DateTime
  status    WeeklyReportStatus @default(DRAFT)
  note            String? @db.LongText
  learnings       String? @db.LongText
  accomplishments String? @db.LongText
  timeSummary     String? @db.LongText
  blockers        String? @db.LongText
  nextWeekPlan    String? @db.LongText

  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewNote  String?
  reviewerId  String?
  reviewer    User?     @relation("WeeklyReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  rows WeeklyReportRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([weekStart])
  @@index([status])
  @@index([reviewerId])
}

model WeeklyReportRow {
  id String @id @default(cuid())

  reportId String
  report   WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  workDate  DateTime
  customer  String?
  machine   String?
  content   String?
  result    String?
  pending   String?
  proposal  String?
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId, sortOrder])
  @@index([workDate])
}

model DailyReport {
  id String @id @default(cuid())

  userId String
  user   User   @relation("DailyReportUser", fields: [userId], references: [id], onDelete: Cascade)

  reportDate DateTime
  status     DailyReportStatus @default(DRAFT)
  summary    String?           @db.Text
  pending    String?           @db.Text
  proposal   String?           @db.Text

  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewNote  String?   @db.Text
  reviewerId  String?
  reviewer    User?     @relation("DailyReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, reportDate])
  @@index([reportDate])
  @@index([status])
  @@index([reviewerId])
}

model Attachment {
  id String @id @default(cuid())

  entityType String
  entityId   String
  type       AttachmentType @default(OTHER)

  originalName String
  storedName   String
  mimeType     String
  size         Int
  path         String
  url          String
  fileData     Bytes? @db.LongBlob

  title       String?
  description String?

  uploadedById    String?
  uploadedBy      User?   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByEmail String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([type])
  @@index([uploadedById])
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  action     String
  entityType String
  entityId   String

  actorId    String?
  actor      User?   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?

  changes  Json?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model DataImportBatch {
  id              String                @id @default(cuid())
  sourceFileName  String
  fileHash        String
  status          DataImportBatchStatus @default(PREVIEW)
  previewData     String                @db.LongText
  summary         Json
  result          Json?
  error           String?               @db.Text
  createdById     String?
  createdBy       User?                 @relation("DataImportBatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([fileHash])
  @@index([createdById])
}

model EngineerProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  employeeCode        String?         @unique
  dateOfBirth         DateTime?
  position            String?
  department          String?
  workStartDate       DateTime?
  specialties         Json            @default("[]")
  expertiseGroup      ExpertiseGroup?
  expertiseImaging    Boolean         @default(false)
  expertiseLabTesting Boolean         @default(false)
  certificateNo       String?
  photoUrl            String?         @db.Text
  note                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(cuid())

  customerCode String? @unique

  name      String
  shortName String?

  hospitalName String?
  customerType CustomerType   @default(HOSPITAL)
  status       CustomerStatus @default(ACTIVE)
  salesChannel CustomerSalesChannel?

  dealerId        String?
  dealer          Customer?  @relation("CustomerDealer", fields: [dealerId], references: [id], onDelete: SetNull)
  dealerCustomers Customer[] @relation("CustomerDealer")

  taxCode String?
  email   String?
  website String?

  phone String?

  contactPerson   String?
  contactPosition String?
  contactPhone    String?
  contactEmail    String?

  province    String?
  provinceId  String?
  provinceRef Province? @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  district    String?
  locality    String?
  ward        String?
  address     String?
  fullAddress String?

  note String? @db.Text

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  importReviewRegionId String?
  importReviewRegion   Region? @relation("CustomerImportReviewRegion", fields: [importReviewRegionId], references: [id], onDelete: SetNull)

  primaryEngineerId String?
  primaryEngineer   User?   @relation("CustomerPrimaryEngineer", fields: [primaryEngineerId], references: [id], onDelete: SetNull)
  engineers         User[]  @relation("CustomerEngineers")
  contacts          CustomerContact[]

  machines                Machine[]
  inventoryMovements      MachineInventoryMovement[]
  machineInstallations    MachineInstallation[]
  demoLoans               DemoLoan[]
  warrantyCards           WarrantyCard[]
  repairs                 Repair[]
  maintenances            Maintenance[]
  deviceServiceTickets    DeviceServiceTicket[]
  applicationSupportCases ApplicationSupportCase[]
  accessoryStockMovements AccessoryStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([primaryEngineerId])
  @@index([dealerId])
  @@index([importReviewRegionId])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name      String
  position  String?
  phone     String?
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, isPrimary])
}

model BusinessLine {
  id String @id @default(cuid())

  code            String                 @unique
  name            String
  status          BusinessLineStatus     @default(ACTIVE)
  manufacturer    String?
  imageUrl        String?                @db.Text
  productCategory MachineProductCategory @default(OTHER)
  countryOfOrigin String?
  website         String?
  contactPerson   String?
  contactPhone    String?
  contactEmail    String?
  description     String?                @db.Text
  note            String?                @db.Text
  expertiseGroup  ExpertiseGroup         @default(IMAGING)

  productIndustryId String?
  productIndustry   ProductIndustry? @relation(fields: [productIndustryId], references: [id], onDelete: SetNull)

  managerId String?
  manager   User?   @relation("BusinessLineManager", fields: [managerId], references: [id], onDelete: SetNull)

  machines             Machine[]
  machineModels        MachineModel[]
  machineInstallations MachineInstallation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MachineModel {
  id String @id @default(cuid())

  code        String
  name        String
  displayName String?
  status      BusinessLineStatus @default(ACTIVE)

  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])

  manufacturer    String?
  countryOfOrigin String?
  productCategory MachineProductCategory @default(OTHER)
  productLine     String?
  description     String?                @db.Text
  note            String?                @db.Text

  machines                Machine[]
  components              MachineComponent[]
  componentAccessories    ComponentAccessory[]
  plannedInstallations    MachineInstallation[]    @relation("PlannedInstallationModel")
  applicationSupportCases ApplicationSupportCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessLineId, code])
  @@index([businessLineId])
  @@index([status])
}

model MachineComponent {
  id String @id @default(cuid())

  code        String
  name        String
  description String?
  sortOrder   Int                @default(0)
  status      BusinessLineStatus @default(ACTIVE)

  machineModelId String
  machineModel   MachineModel @relation(fields: [machineModelId], references: [id], onDelete: Cascade)

  accessories Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ComponentAccessory ComponentAccessory[]

  @@unique([machineModelId, code])
  @@index([machineModelId])
  @@index([status])
}

model ComponentAccessory {
  id String @id @default(cuid())

  code           String
  name           String
  description    String?
  unit           String             @default("cái")
  quantity       Int                @default(1)
  requiresSerial Boolean            @default(true)
  unitCost       Decimal?           @db.Decimal(15, 2)
  salePrice      Decimal?           @db.Decimal(15, 2)
  sortOrder      Int                @default(0)
  status         BusinessLineStatus @default(ACTIVE)

  machineModelId String
  machineModel   MachineModel @relation(fields: [machineModelId], references: [id], onDelete: Cascade)

  componentId String?
  component   MachineComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  machineAccessories MachineAccessory[]
  stockMovements     AccessoryStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([machineModelId, code])
  @@index([machineModelId])
  @@index([componentId])
  @@index([status])
}

model AccessoryStockMovement {
  id String @id @default(cuid())

  code String                     @unique
  type AccessoryStockMovementType

  componentAccessoryId String
  componentAccessory   ComponentAccessory @relation(fields: [componentAccessoryId], references: [id], onDelete: Cascade)

  quantityDelta Decimal  @db.Decimal(12, 2)
  unit          String?
  serialNumber  String?
  unitCost      Decimal? @db.Decimal(15, 2)
  unitPrice     Decimal? @db.Decimal(15, 2)
  totalCost     Decimal? @db.Decimal(15, 2)
  totalPrice    Decimal? @db.Decimal(15, 2)
  reason        String?
  note          String?  @db.Text
  occurredAt    DateTime @default(now())

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  repairId String?
  repair   Repair? @relation(fields: [repairId], references: [id], onDelete: Cascade)

  maintenanceId String?
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  deviceServiceTicketId String?
  deviceServiceTicket   DeviceServiceTicket? @relation(fields: [deviceServiceTicketId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("AccessoryStockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([componentAccessoryId])
  @@index([machineId])
  @@index([customerId])
  @@index([repairId])
  @@index([maintenanceId])
  @@index([deviceServiceTicketId])
  @@index([createdById])
  @@index([type])
  @@index([occurredAt])
  @@index([serialNumber])
}

model Machine {
  id String @id @default(cuid())

  machineCode  String? @unique
  serialNumber String  @unique

  name            String?
  imageUrl        String?                @db.Text
  modelName       String
  version         String?
  manufacturer    String
  productCategory MachineProductCategory @default(OTHER)
  productLine     String?

  status                MachineStatus            @default(ACTIVE)
  inventoryStatus       MachineInventoryStatus   @default(IN_STOCK)
  demoCategory          DemoMachineCategory?
  demoPreparationStatus DemoPreparationStatus    @default(NOT_REQUIRED)
  dataStatus            OperationalDataStatus    @default(VERIFIED)
  createdSource         OperationalCreatedSource @default(ADMIN)

  manufacturingDate   DateTime?
  warehouseImportDate DateTime?
  installDate         DateTime?
  warrantyStartDate   DateTime?
  warrantyEndDate     DateTime?
  accessoriesSnapshot Json      @default("[]")

  businessLineId String?
  businessLine   BusinessLine? @relation(fields: [businessLineId], references: [id])

  machineModelId String?
  machineModel   MachineModel? @relation(fields: [machineModelId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  importReviewRegionId String?
  importReviewRegion   Region? @relation("MachineImportReviewRegion", fields: [importReviewRegionId], references: [id], onDelete: SetNull)

  installedById String?
  installedBy   User?   @relation("MachineInstalledBy", fields: [installedById], references: [id])
  installedByNameSnapshot String?
  checkedByNameSnapshot   String?

  primaryEngineerId   String?
  primaryEngineer     User?                       @relation("MachinePrimaryEngineer", fields: [primaryEngineerId], references: [id])
  engineerAssignments MachineEngineerAssignment[]

  repairs                 Repair[]
  maintenances            Maintenance[]
  deviceServiceTickets    DeviceServiceTicket[]
  inventoryMovements      MachineInventoryMovement[]
  installations           MachineInstallation[]
  demoLoans               DemoLoan[]
  warrantyCards           WarrantyCard[]
  accessories             MachineAccessory[]
  applicationSupportCases ApplicationSupportCase[]
  accessoryStockMovements AccessoryStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MachineEngineerAssignment {
  machineId  String
  engineerId String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())
  machine    Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  engineer   User     @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@id([machineId, engineerId])
  @@index([engineerId, assignedAt])
}

model DemoLoan {
  id String @id @default(cuid())

  code                        String                @unique
  ticketCode                  String?
  status                      DemoLoanStatus        @default(PLANNED)
  machineUse                  DemoLoanMachineUse    @default(UNKNOWN)
  preparationStatus           DemoPreparationStatus @default(NOT_REQUIRED)
  preparedAt                  DateTime?
  preparationNote             String?               @db.Text
  previousMachineDemoCategory DemoMachineCategory?
  returnRequiresRepair        Boolean               @default(false)

  machineId String
  machine   Machine @relation(fields: [machineId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  engineerId  String
  engineer    User                 @relation("DemoLoanEngineer", fields: [engineerId], references: [id], onDelete: Restrict)
  assignments DemoLoanAssignment[]

  handedOverById String?
  handedOverBy   User? @relation("DemoLoanHandedOverBy", fields: [handedOverById], references: [id], onDelete: SetNull)
  returnedById   String?
  returnedBy     User? @relation("DemoLoanReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  plannedHandoverAt DateTime
  handedOverAt      DateTime?
  expectedReturnAt  DateTime
  returnedAt        DateTime?

  handoverAddress     String?
  receiverName        String?
  receiverPosition    String?
  receiverPhone       String?
  handoverCondition   String? @db.Text
  handoverAccessories Json?
  handoverNote        String? @db.Text
  returnCondition     String? @db.Text
  returnAccessories   Json?
  returnNote          String? @db.Text
  purpose             String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId])
  @@index([ticketCode])
  @@index([customerId])
  @@index([engineerId])
  @@index([status])
  @@index([plannedHandoverAt])
  @@index([expectedReturnAt])
  @@index([returnedAt])
}

model DemoLoanAssignment {
  demoLoanId String
  engineerId String
  isLead     Boolean  @default(false)
  assignedAt DateTime @default(now())
  demoLoan   DemoLoan @relation(fields: [demoLoanId], references: [id], onDelete: Cascade)
  engineer   User     @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@id([demoLoanId, engineerId])
  @@index([engineerId, assignedAt])
}

model DeviceServiceTicket {
  id String @id @default(cuid())

  receiveCode String                    @unique
  returnCode  String?                   @unique
  status      DeviceServiceTicketStatus @default(RECEIVED)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  engineerId String?
  engineer   User?   @relation(fields: [engineerId], references: [id], onDelete: SetNull)

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  receivedAt DateTime  @default(now())
  returnedAt DateTime?

  usingDepartment        String?
  representative         String?
  representativePosition String?
  contactPhone           String?
  address                String?
  deviceName             String?
  modelName              String?
  serialNumber           String?
  warrantyStatus         String?
  warrantyTerm           String?
  receivedCondition      String? @db.Text
  receivedAccessories    String? @db.Text
  preliminaryCause       String? @db.Text
  repairMethod           String? @db.Text
  repairCostItems        String? @db.Text
  resultNote             String? @db.Text
  returnCondition        String? @db.Text
  totalRepairCost        String?
  repairCostInWords      String?
  note                   String? @db.Text

  createdById String?
  createdBy   User?   @relation("DeviceServiceTicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  usedParts               UsedPart[]
  accessoryStockMovements AccessoryStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([engineerId])
  @@index([machineId])
  @@index([receivedAt])
  @@index([returnedAt])
}

model MachineAccessory {
  id String @id @default(cuid())

  machineId String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  componentAccessoryId String?
  componentAccessory   ComponentAccessory? @relation(fields: [componentAccessoryId], references: [id], onDelete: SetNull)

  code         String?
  name         String
  quantity     Int     @default(1)
  serialNumber String? @unique
  description  String?
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId])
  @@index([componentAccessoryId])
  @@index([name])
}

model ApplicationSupportCase {
  id String @id @default(cuid())

  engineerId String
  engineer   User   @relation("ApplicationSupportEngineer", fields: [engineerId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  machineModelId String?
  machineModel   MachineModel? @relation(fields: [machineModelId], references: [id], onDelete: SetNull)

  supportedAt   DateTime
  channel       ApplicationSupportChannel       @default(PHONE)
  workType      ApplicationSupportWorkType      @default(APP_SUPPORT)
  issueCategory ApplicationSupportIssueCategory @default(APP_ERROR)
  status        ApplicationSupportStatus        @default(RESOLVED)

  customerName      String?
  contactName       String?
  contactPhone      String?
  appModule         String?
  machineText       String?
  impactLevel       String?
  reagentName       String?
  reagentLot        String?
  reagentExpiry     DateTime?
  assayName         String?
  qcResult          String?
  calibrationResult String?
  lisHisStatus      String?

  title            String
  issueDescription String  @db.Text
  resolution       String  @db.Text
  durationMinutes  Int?
  pending          String? @db.Text
  nextAction       String? @db.Text

  followUpNeeded     Boolean   @default(false)
  followUpDate       DateTime?
  knowledgeCandidate Boolean   @default(false)
  note               String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([engineerId, supportedAt])
  @@index([customerId])
  @@index([machineId])
  @@index([machineModelId])
  @@index([status])
  @@index([workType])
  @@index([issueCategory])
}

model MachineInstallation {
  id String @id @default(cuid())

  code   String             @unique
  status InstallationStatus @default(INSTALLED)

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])

  plannedMachineModelId String?
  plannedMachineModel   MachineModel? @relation("PlannedInstallationModel", fields: [plannedMachineModelId], references: [id], onDelete: SetNull)
  plannedModelName      String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  businessLineId String?
  businessLine   BusinessLine? @relation(fields: [businessLineId], references: [id], onDelete: SetNull)

  installedById String?
  installedBy   User?   @relation("MachineInstallationEngineer", fields: [installedById], references: [id], onDelete: SetNull)

  installedAt DateTime
  accessories Json     @default("[]")
  note        String?

  warrantyStartDate DateTime?
  warrantyEndDate   DateTime?
  warrantyNote      String?

  handoverInstallerName     String?
  checkedByNameSnapshot     String?
  legacySourceSheet         String?
  legacySourceRow           Int?
  handoverInstallerPosition String?
  handoverVehicle           String?
  handoverDepartureDate     DateTime?
  receiverInstallAddress    String?
  receiverRepresentative    String?
  receiverPosition          String?
  receiverPhone             String?
  installedDeviceItems      Json?
  deviceCondition           String?
  deviceConditionNote       String?

  reviewStatus WorkReviewStatus @default(NOT_REQUIRED)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewerId   String?
  reviewer     User?            @relation("InstallationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  warrantyCard   WarrantyCard?
  workLogs       WorkLog[]
  usedParts      UsedPart[]
  checklistItems TaskChecklistItem[]
  assignments    InstallationAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId])
  @@index([plannedMachineModelId])
  @@index([customerId])
  @@index([businessLineId])
  @@index([installedById])
  @@index([installedAt])
  @@index([status])
  @@index([reviewStatus])
  @@index([reviewerId])
}

model InstallationAssignment {
  installationId String
  installation   MachineInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  engineerId     String
  engineer       User                @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  isLead         Boolean             @default(false)
  assignedAt     DateTime            @default(now())

  @@id([installationId, engineerId])
  @@index([engineerId, assignedAt])
}

model WarrantyCard {
  id String @id @default(cuid())

  code   String         @unique
  status WarrantyStatus @default(ACTIVE)

  installationId String              @unique
  installation   MachineInstallation @relation(fields: [installationId], references: [id])

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  issuedAt  DateTime @default(now())
  startDate DateTime
  endDate   DateTime
  note      String?

  issuedById    String?
  issuedBy      User?   @relation("WarrantyCardIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId])
  @@index([customerId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model MachineInventoryMovement {
  id String @id @default(cuid())

  code String                @unique
  type InventoryMovementType

  machineId String
  machine   Machine @relation(fields: [machineId], references: [id])

  fromStatus MachineInventoryStatus?
  toStatus   MachineInventoryStatus

  occurredAt DateTime @default(now())
  note       String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Maintenance {
  id String @id @default(cuid())

  code        String  @unique
  title       String
  description String?

  type   MaintenanceType   @default(PERIODIC)
  status MaintenanceStatus @default(SCHEDULED)

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  engineerId String?
  engineer   User?   @relation(fields: [engineerId], references: [id])

  scheduledDate DateTime
  assignedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?

  checklist           Json      @default("[]")
  receivedAccessories String?   @db.Text
  resultNote          String?
  nextDueDate         DateTime?

  reviewStatus WorkReviewStatus @default(NOT_REQUIRED)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewerId   String?
  reviewer     User?            @relation("MaintenanceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  usingDepartment String?
  representative  String?
  address         String?
  contactPhone    String?
  deviceName      String?
  modelName       String?
  serialNumber    String?

  workLogs                WorkLog[]
  usedParts               UsedPart[]
  accessoryStockMovements AccessoryStockMovement[]
  checklistItems          TaskChecklistItem[]
  assignments             MaintenanceAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewStatus])
  @@index([reviewerId])
  @@index([customerId])
  @@index([scheduledDate])
}

model MaintenanceAssignment {
  maintenanceId String
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  engineerId    String
  engineer      User        @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  isLead        Boolean     @default(false)
  assignedAt    DateTime    @default(now())

  @@id([maintenanceId, engineerId])
  @@index([engineerId, assignedAt])
}

model Repair {
  id String @id @default(cuid())

  code String @unique

  title       String
  description String?

  status   RepairStatus   @default(PENDING)
  priority RepairPriority @default(NORMAL)

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  engineerId String?
  engineer   User?   @relation("RepairEngineer", fields: [engineerId], references: [id])

  createdById String?
  createdBy   User?   @relation("RepairCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  reportedAt  DateTime  @default(now())
  assignedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  resultNote       String?
  customerFeedback String?

  reviewStatus WorkReviewStatus @default(NOT_REQUIRED)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewerId   String?
  reviewer     User?            @relation("RepairReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  usingDepartment        String?
  representative         String?
  representativePosition String?
  address                String?
  contactPhone           String?
  deviceName             String?
  modelName              String?
  serialNumber           String?
  warrantyStatus         String?
  warrantyTerm           String?
  receivedAccessories    String? @db.Text
  preliminaryCause       String? @db.Text
  conditionAssessment    String?
  repairMethod           String?
  repairCostItems        String? @db.Text
  totalRepairCost        String?
  repairCostInWords      String?

  workLogs                WorkLog[]
  usedParts               UsedPart[]
  accessoryStockMovements AccessoryStockMovement[]
  checklistItems          TaskChecklistItem[]
  assignments             RepairAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([reviewStatus])
  @@index([reviewerId])
  @@index([customerId])
  @@index([reportedAt])
}

model RepairAssignment {
  repairId   String
  repair     Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  engineerId String
  engineer   User     @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  isLead     Boolean  @default(false)
  assignedAt DateTime @default(now())

  @@id([repairId, engineerId])
  @@index([engineerId, assignedAt])
}

model WorkLog {
  id String @id @default(cuid())

  kind WorkTaskKind

  repairId String?
  repair   Repair? @relation(fields: [repairId], references: [id], onDelete: Cascade)

  maintenanceId String?
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  installationId String?
  installation   MachineInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)

  stepTime  DateTime?
  title     String
  note      String?   @db.Text
  sortOrder Int       @default(0)

  createdById String?
  createdBy   User?   @relation("WorkLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([repairId])
  @@index([maintenanceId])
  @@index([installationId])
  @@index([createdById])
  @@index([stepTime])
}

model UsedPart {
  id String @id @default(cuid())

  kind WorkTaskKind

  repairId String?
  repair   Repair? @relation(fields: [repairId], references: [id], onDelete: Cascade)

  maintenanceId String?
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  installationId String?
  installation   MachineInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)

  deviceServiceTicketId String?
  deviceServiceTicket   DeviceServiceTicket? @relation(fields: [deviceServiceTicketId], references: [id], onDelete: Cascade)

  name            String
  quantity        Decimal        @default(1) @db.Decimal(12, 2)
  unit            String?
  serialNumber    String?
  unitCost        Decimal?       @db.Decimal(15, 2)
  totalCost       Decimal?       @db.Decimal(15, 2)
  unitPrice       Decimal?       @db.Decimal(15, 2)
  totalPrice      Decimal?       @db.Decimal(15, 2)
  status          UsedPartStatus @default(USED)
  inventoryItemId String?
  note            String?        @db.Text
  usedAt          DateTime?

  createdById String?
  createdBy   User?   @relation("UsedPartCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([repairId])
  @@index([maintenanceId])
  @@index([installationId])
  @@index([deviceServiceTicketId])
  @@index([createdById])
  @@index([status])
  @@index([usedAt])
  @@index([inventoryItemId])
}

model TaskChecklistItem {
  id String @id @default(cuid())

  kind WorkTaskKind

  repairId String?
  repair   Repair? @relation(fields: [repairId], references: [id], onDelete: Cascade)

  maintenanceId String?
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  installationId String?
  installation   MachineInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)

  label     String
  status    TaskChecklistStatus @default(PENDING)
  note      String?             @db.Text
  sortOrder Int                 @default(0)
  checkedAt DateTime?

  updatedById String?
  updatedBy   User?   @relation("TaskChecklistUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([repairId])
  @@index([maintenanceId])
  @@index([installationId])
  @@index([status])
  @@index([updatedById])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  href    String?

  entityType String?
  entityId   String?

  createdById String?
  createdBy   User?   @relation("NotificationSender", fields: [createdById], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([entityType, entityId])
  @@index([createdById])
}
