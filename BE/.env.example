# ============================================================
# VIETMED BACKEND - FILE MẪU MÔI TRƯỜNG
# Copy file này thành .env rồi điền giá trị thật
#   - Local/Docker: giữ nguyên giá trị dev bên dưới
#   - cPanel production: xem BE/.env.production
# ============================================================

# --- Database (MySQL) ---
# Local:
DATABASE_URL="mysql://vietmed:vietmed_password@127.0.0.1:3306/vietmed_system_mysql"
# Trên cPanel, user/db luôn có tiền tố tên tài khoản hosting, ví dụ:
# DATABASE_URL="mysql://cpaneluser_vietmed:MAT_KHAU@localhost:3306/cpaneluser_vietmed"

# --- Ứng dụng ---
NODE_ENV=development          # production khi deploy
PORT=3000                     # Passenger trên cPanel sẽ tự ghi đè PORT

# --- JWT ---
# Production: bắt buộc >= 32 ký tự, không dùng giá trị mặc định
JWT_SECRET=vietmed-local-dev-secret-please-change-before-production-2026
JWT_EXPIRES_IN=28800          # giây; production tối đa 43200 (12h)
JWT_ISSUER=vietmed-ky-thuat-api
JWT_AUDIENCE=vietmed-ky-thuat-web

# --- CORS ---
# Bắt buộc khi NODE_ENV=production. Phân tách bằng dấu phẩy, KHÔNG có dấu / cuối
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# --- Khác ---
ENABLE_SWAGGER=false
